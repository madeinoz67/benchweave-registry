{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchweave-registry:publishers:2.0.0",
  "title": "BenchWeave registry vetted publishers",
  "description": "Vetted publisher identities and their namespace assignments (CR-15/CR-39). A publisher identity is a GitHub identity plus a publisher name (NFR-7); nothing more is collected.",
  "type": "object",
  "required": [
    "publishers_version",
    "publishers"
  ],
  "additionalProperties": false,
  "properties": {
    "publishers_version": {
      "const": 2
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "publisher_id",
          "namespace",
          "github",
          "vetted_at",
          "publisher_repo_protections",
          "vetting"
        ],
        "additionalProperties": false,
        "properties": {
          "publisher_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "The namespace this publisher owns (CR-15): package ids under this prefix belong to this publisher."
          },
          "github": {
            "type": "string",
            "minLength": 1
          },
          "vetted_at": {
            "type": "string",
            "format": "date-time"
          },
          "publisher_repo_protections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "protection",
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "protection": {
                  "enum": [
                    "push-protection",
                    "code-scanning",
                    "advisories"
                  ]
                },
                "state": {
                  "const": "declared-not-verified",
                  "description": "Q21: declared in the CR-39 vetting checklist and rendered declared-not-verified; no enforcement claim is made over repositories the lane cannot read."
                }
              }
            }
          },
          "ed25519_public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----",
            "description": "The publisher's recorded Ed25519 public key (PEM): what the registry verifies publisher signatures against. The registry never holds a private key."
          },
          "key_validity": {
            "type": "object",
            "required": [
              "not_before",
              "not_after"
            ],
            "additionalProperties": false,
            "properties": {
              "not_before": {
                "type": "string",
                "format": "date-time"
              },
              "not_after": {
                "type": "string",
                "format": "date-time"
              }
            },
            "description": "The signing key's validity window; with a trusted timestamp, validity is judged at the TSA-attested signing time."
          },
          "vetting": {
            "type": "object",
            "required": [
              "checklist_id",
              "checklist_version",
              "cited_rows",
              "vetted_by"
            ],
            "additionalProperties": false,
            "properties": {
              "checklist_id": {
                "const": "vetting-checklist"
              },
              "checklist_version": {
                "const": "1"
              },
              "cited_rows": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^V-[0-9]{2}$"
                },
                "description": "The vetting-checklist rows walked for this publisher; the validity gate resolves each against vetting-checklist.md — an unknown row refuses (vetting_row_unknown:)."
              },
              "vetted_by": {
                "type": "string",
                "minLength": 1,
                "description": "The GitHub identity that performed the vetting — the accountable one."
              }
            },
            "description": "The machine-citable vetting citation (schema v2, issue #225 slice 3): which checklist version, which rows, who walked them. Structural validity of the citation never establishes the vetting was sound — that accountability stays with vetted_by."
          }
        }
      }
    }
  }
}
