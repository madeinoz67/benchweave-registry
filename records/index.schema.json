{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchweave-registry:index:1.0.0",
  "title": "BenchWeave registry catalogue index",
  "description": "The ONE generated JSON index serving catalogue, search and verification (PRD §9 Q7/CR-26). Generated from records/ + releases/ by scripts/generate_index.py; never hand-edited (CR-21) — the CI regeneration check refuses drift. The format is settled at slice 1 so the website slice only RENDERS it (additive), never reshapes the records home or this format. The row fields carry what the public-site styleguide's display semantics need (kind, provenance, unverified markers, maintenance state).",
  "type": "object",
  "required": ["index_version", "generated_from", "rows"],
  "additionalProperties": false,
  "properties": {
    "index_version": {
      "const": 1
    },
    "generated_from": {
      "type": "object",
      "required": ["records_tree", "releases_tree"],
      "additionalProperties": false,
      "properties": {
        "records_tree": {
          "const": "records/"
        },
        "releases_tree": {
          "const": "releases/"
        }
      },
      "description": "Provenance of the index: derived solely from committed trees, offline."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "registry_id",
          "package_id",
          "version",
          "kind",
          "publisher",
          "manifest_sha256",
          "signed",
          "display_name",
          "summary",
          "licence_spdx",
          "compatibility",
          "evidence",
          "maintenance",
          "advisories",
          "capabilities",
          "transport_triples",
          "source_revision",
          "unverified_markers"
        ],
        "additionalProperties": false,
        "properties": {
          "registry_id": {"type": "string", "minLength": 1},
          "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9_-]*$"},
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "kind": {
            "enum": ["admitted-release", "in-tree-fixture", "community-shared"],
            "description": "CR-56: never rendered without the tag; shared entries never render as admitted."
          },
          "publisher": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "signed": {
            "type": "boolean",
            "description": "Signature presence (manifest.sig + status.sig verified at generation)."
          },
          "display_name": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "licence_spdx": {"type": "string", "minLength": 1},
          "compatibility": {
            "type": "object",
            "description": "Verbatim from the release manifest's compatibility block (CR-19: rendered without re-derivation).",
            "required": ["otdp_versions", "adapter_api_versions", "stg_versions"],
            "additionalProperties": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "report_path", "result"],
              "additionalProperties": false,
              "properties": {
                "level": {"enum": ["structural", "simulated", "hardware"]},
                "report_path": {"type": "string", "minLength": 1},
                "result": {"enum": ["passed", "failed", "partial"]}
              }
            },
            "description": "Self-attested conformance evidence, carried with its unverified marker."
          },
          "maintenance": {
            "enum": ["maintained", "maintenance_only", "unmaintained", "unknown"],
            "description": "From the release's status document; 'unknown' renders honestly."
          },
          "advisories": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "description": "Advisory identifiers from records; empty when none."
          },
          "capabilities": {
            "type": "object",
            "required": [
              "network_egress",
              "subprocess_or_native_library",
              "filesystem_writes_beyond_evidence_retention"
            ],
            "additionalProperties": false,
            "properties": {
              "network_egress": {"type": "boolean"},
              "subprocess_or_native_library": {"type": "boolean"},
              "filesystem_writes_beyond_evidence_retention": {"type": "boolean"}
            },
            "description": "The CR-45 declaration as discovery input (enforcement is deploy-policy only, Q13)."
          },
          "transport_triples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "version", "sha256"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          "source_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$",
            "description": "CR-36's immutable commit digest, verbatim from the manifest."
          },
          "unverified_markers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "description": "CR-37: every self-attested surface renders with its marker; a clean digest or scan never renders as 'verified' (NFR-S1)."
          }
        }
      }
    }
  }
}
