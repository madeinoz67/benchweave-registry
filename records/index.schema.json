{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchweave-registry:index:1.0.0",
  "title": "BenchWeave registry catalogue index",
  "description": "The ONE generated JSON index serving catalogue, search and verification (PRD \u00a79 Q7/CR-26). Generated from records/ + releases/ by scripts/generate_index.py; never hand-edited (CR-21) \u2014 the CI regeneration check refuses drift. The format is settled at slice 1 so the website slice only RENDERS it (additive), never reshapes the records home or this format. The row fields carry what the public-site styleguide's display semantics need (kind, provenance, unverified markers, maintenance state). Issue #227 slice 5 extended the row shape ADDITIVELY: one optional property (source_url) and a kind-conditional block that binds community-shared rows only — every release row validates exactly as before.",
  "type": "object",
  "required": [
    "index_version",
    "generated_from",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "index_version": {
      "const": 1
    },
    "generated_from": {
      "type": "object",
      "required": [
        "records_tree",
        "releases_tree"
      ],
      "additionalProperties": false,
      "properties": {
        "records_tree": {
          "const": "records/"
        },
        "releases_tree": {
          "const": "releases/"
        }
      },
      "description": "Provenance of the index: derived solely from committed trees, offline."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "registry_id",
          "package_id",
          "version",
          "kind",
          "publisher",
          "manifest_sha256",
          "display_name",
          "summary",
          "licence_spdx",
          "compatibility",
          "evidence",
          "maintenance",
          "advisories",
          "capabilities",
          "transport_triples",
          "source_revision",
          "unverified_markers",
          "gateway_ref",
          "firmware_attestation",
          "signature_state",
          "timestamp",
          "timestamp_recommended"
        ],
        "additionalProperties": false,
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9_-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "kind": {
            "enum": [
              "admitted-release",
              "in-tree-fixture",
              "community-shared"
            ],
            "description": "CR-56: never rendered without the tag; shared entries never render as admitted. Generated from a record, never defaulted (issue #227 slice 5): a release row reads its kind from its review or publish record, a community-shared row from a share record."
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "The release manifest's SHA-256. On a community-shared row there is no manifest: the value is the SHA-256 of the canonical share record, the only bytes the registry holds for a listing."
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "licence_spdx": {
            "type": "string",
            "minLength": 1
          },
          "compatibility": {
            "type": "object",
            "description": "Verbatim from the release manifest's compatibility block (CR-19: rendered without re-derivation).",
            "required": [
              "otdp_versions",
              "adapter_api_versions",
              "stg_versions"
            ],
            "additionalProperties": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "level",
                "report_path",
                "result"
              ],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "enum": [
                    "structural",
                    "simulated",
                    "hardware"
                  ]
                },
                "report_path": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "passed",
                    "failed",
                    "partial"
                  ]
                }
              }
            },
            "description": "Self-attested conformance evidence, carried with its unverified marker."
          },
          "maintenance": {
            "enum": [
              "maintained",
              "maintenance_only",
              "unmaintained",
              "unknown"
            ],
            "description": "From the release's status document; 'unknown' renders honestly."
          },
          "advisories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Advisory identifiers from records; empty when none."
          },
          "capabilities": {
            "type": "object",
            "required": [
              "network_egress",
              "subprocess_or_native_library",
              "filesystem_writes_beyond_evidence_retention"
            ],
            "additionalProperties": false,
            "properties": {
              "network_egress": {
                "type": "boolean"
              },
              "subprocess_or_native_library": {
                "type": "boolean"
              },
              "filesystem_writes_beyond_evidence_retention": {
                "type": "boolean"
              }
            },
            "description": "The CR-45 declaration as discovery input (enforcement is deploy-policy only, Q13)."
          },
          "transport_triples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "source_revision": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$",
            "description": "CR-36's immutable commit digest, verbatim from the manifest (on a community-shared row: from the share record)."
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "CR-57 (issue #227 slice 5): the author's source repository. Carried only on a community-shared row, so a consumer reaches the pinned source (this repository at source_revision) in one step. Release rows do not carry it."
          },
          "unverified_markers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "CR-37: every self-attested surface renders with its marker; a clean digest or scan never renders as 'verified' (NFR-S1). A community-shared row must carry community-shared-not-reviewed (CR-57): the whole entry is author-declared."
          },
          "gateway_ref": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
              }
            ],
            "description": "The pinned gateway commit this release targets, advertised (null when the record carries no pin). Never a publish-time gate."
          },
          "firmware_attestation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "vendor",
                  "manifest"
                ],
                "additionalProperties": false,
                "properties": {
                  "vendor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "const": "vendor-distributed"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            ],
            "description": "The recorded vendor attestation, advertised (null when none). Enforcement is the client decision."
          },
          "signature_state": {
            "enum": [
              "signed-valid",
              "unsigned"
            ],
            "description": "The recorded publisher-signature state; replaces the earlier boolean \"signed\" (one source of truth). A community-shared row is always unsigned: a listing carries no signature to check."
          },
          "timestamp": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "tsa",
                  "signed_at",
                  "signature_sha256",
                  "token_sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "tsa": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signed_at": {
                    "type": "string",
                    "minLength": 13
                  },
                  "signature_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "token_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          },
          "timestamp_recommended": {
            "type": "boolean",
            "description": "The advisory, advertised: true when the release is signed but un-timestamped (valid until key expiry)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "community-shared"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "source_url"
              ],
              "properties": {
                "signature_state": {
                  "const": "unsigned"
                },
                "unverified_markers": {
                  "contains": {
                    "const": "community-shared-not-reviewed"
                  }
                },
                "evidence": {
                  "maxItems": 0
                },
                "maintenance": {
                  "const": "unknown"
                },
                "advisories": {
                  "maxItems": 0
                },
                "transport_triples": {
                  "maxItems": 0
                },
                "gateway_ref": {
                  "type": "null"
                },
                "firmware_attestation": {
                  "type": "null"
                },
                "timestamp": {
                  "type": "null"
                },
                "timestamp_recommended": {
                  "const": false
                }
              }
            },
            "description": "CR-57 (issue #227 slice 5): a community-shared row carries no release-class claim. It is unsigned, it carries its unverified marker, it links its pinned source, and it carries no evidence, advisory, transport, maintenance, gateway, firmware or timestamp state. A shared listing is not a release and is never rendered as admitted."
          }
        ]
      }
    }
  }
}
